<!DOCTYPE html>
<html lang="ne" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MSR — 3-in-1 Official Donation QR Poster</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700;800&family=Poppins:wght@600;700;800;900&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        msr: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            800: '#166534',
                            900: '#14532d',
                            950: '#052e16',
                        },
                        accent: '#f4b942',
                        esewa: '#60bb46',
                        khalti: '#5c2d91',
                        bank: '#00529b'
                    },
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans Devanagari', 'sans-serif'],
                        heading: ['Poppins', 'Noto Sans Devanagari', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <!-- Client-Side QRCode.js Engine -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
            font-family: 'Inter', 'Noto Sans Devanagari', sans-serif;
        }

        .poster-card {
            background: linear-gradient(145deg, #052e16 0%, #14532d 50%, #0a3a1f 100%);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.1);
        }

        .qr-frame {
            background: #ffffff;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .qr-frame:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .gold-border {
            border: 2px solid #f4b942;
        }

        /* Canvas Export Hide/Show */
        #export-canvas {
            display: none;
        }
    </style>
</head>
<body class="min-h-screen py-8 px-4 flex flex-col items-center justify-center selection:bg-amber-400 selection:text-slate-900">

    <!-- TOP TOOLBAR -->
    <div class="max-w-4xl w-full mb-6 flex flex-wrap items-center justify-between gap-4 bg-slate-800/80 p-4 rounded-2xl border border-slate-700 backdrop-blur-md">
        <div>
            <h1 class="text-lg font-heading font-bold text-white flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
                MSR Official 3-in-1 Donation QR Poster
            </h1>
            <p class="text-xs text-slate-400">Professional, Trustworthy & Perfectly Aligned Standee</p>
        </div>

        <div class="flex items-center gap-3">
            <button onclick="downloadPosterImage()" class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-heading font-extrabold text-xs sm:text-sm px-5 py-2.5 rounded-xl shadow-lg transition-all flex items-center gap-2 active:scale-95">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
                <span>Download HD Image (PNG)</span>
            </button>
        </div>
    </div>

    <!-- MAIN VISUAL POSTER CONTAINER (PREVIEW AREA) -->
    <div id="poster-element" class="poster-card max-w-3xl w-full rounded-3xl p-6 sm:p-10 border border-emerald-600/30 text-white relative overflow-hidden">
        
        <!-- DECORATIVE BACKGROUND ACCENTS -->
        <div class="absolute -top-24 -right-24 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <!-- POSTER HEADER / BRANDING -->
        <div class="text-center space-y-3 pb-6 border-b border-emerald-800/80 relative z-10">
            <div class="inline-flex items-center gap-2 bg-emerald-950/80 border border-amber-400/40 px-4 py-1.5 rounded-full shadow-inner">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
                <span class="text-xs font-extrabold text-amber-300 uppercase tracking-widest">100% Transparent & Verified Initiative</span>
            </div>

            <div class="flex items-center justify-center gap-3 pt-1">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-600 to-emerald-900 border-2 border-amber-400 flex items-center justify-center shadow-lg text-amber-300">
                    <svg class="w-7 h-7 fill-none stroke-current stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 4a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
                        <path d="M6 10c0-1.1.9-2 2-2h8a2 2 0 0 1 2 2v3a1 1 0 0 1-1 1h-2v6a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1v-6H7a1 1 0 0 1-1-1v-3z"/>
                        <path d="M12 12l3-3m-6 0l3 3" class="stroke-emerald-300"/>
                    </svg>
                </div>
                <div class="text-left">
                    <h2 class="text-2xl sm:text-3xl font-heading font-black tracking-tight text-white leading-none">
                        MSR
                    </h2>
                    <span class="text-xs font-bold text-emerald-300 tracking-wider uppercase block mt-0.5">
                        Make Someone Rise
                    </span>
                </div>
            </div>

            <p class="text-xs sm:text-sm font-medium text-emerald-100 max-w-lg mx-auto leading-relaxed pt-1">
                “तपाईंको सानो सहयोग, कसैको जीवन उठाउने ठूलो शक्ति बन्न सक्छ।”
                <br>
                <span class="text-amber-300/90 italic font-normal text-[11px]">“Your small contribution can become a powerful force that helps someone rise again.”</span>
            </p>
        </div>

        <!-- TRUST ASSURANCE BADGES -->
        <div class="py-4 my-2 grid grid-cols-3 gap-2 text-center text-[10px] sm:text-xs font-bold text-emerald-200 uppercase tracking-wider relative z-10">
            <div class="bg-emerald-900/40 p-2 rounded-xl border border-emerald-700/50 flex flex-col sm:flex-row items-center justify-center gap-1.5">
                <span class="text-base">🛡️</span> Direct Relief Fund
            </div>
            <div class="bg-emerald-900/40 p-2 rounded-xl border border-emerald-700/50 flex flex-col sm:flex-row items-center justify-center gap-1.5">
                <span class="text-base">🤝</span> Verified Beneficiaries
            </div>
            <div class="bg-emerald-900/40 p-2 rounded-xl border border-emerald-700/50 flex flex-col sm:flex-row items-center justify-center gap-1.5">
                <span class="text-base">📊</span> Public Audit Records
            </div>
        </div>

        <!-- 3-IN-1 QR GRID ARRANGEMENT -->
        <div class="grid md:grid-cols-3 gap-5 py-4 relative z-10">
            
            <!-- 1. ESEWA QR FRAME -->
            <div class="qr-frame rounded-2xl p-4 text-center border-2 border-emerald-500/30 flex flex-col justify-between shadow-xl">
                <div>
                    <div class="bg-esewa text-white font-heading font-extrabold text-xs py-1.5 px-3 rounded-xl mb-3 flex items-center justify-center gap-1.5 shadow-sm">
                        <span class="w-2 h-2 rounded-full bg-white"></span>
                        eSewa QR
                    </div>
                    <div id="qr-esewa-container" class="w-[150px] h-[150px] mx-auto bg-white p-1 rounded-xl flex items-center justify-center border border-slate-100">
                        <!-- Rendered by QRCode.js -->
                    </div>
                </div>
                <div class="mt-3 pt-2 border-t border-slate-100">
                    <span class="text-[10px] font-bold text-slate-500 uppercase block">Scan with eSewa App</span>
                    <span class="text-[11px] font-extrabold text-emerald-800 block">Instant Voluntary Aid</span>
                </div>
            </div>

            <!-- 2. KHALTI QR FRAME -->
            <div class="qr-frame rounded-2xl p-4 text-center border-2 border-purple-500/30 flex flex-col justify-between shadow-xl">
                <div>
                    <div class="bg-khalti text-white font-heading font-extrabold text-xs py-1.5 px-3 rounded-xl mb-3 flex items-center justify-center gap-1.5 shadow-sm">
                        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                        Khalti QR
                    </div>
                    <div id="qr-khalti-container" class="w-[150px] h-[150px] mx-auto bg-white p-1 rounded-xl flex items-center justify-center border border-slate-100">
                        <!-- Rendered by QRCode.js -->
                    </div>
                </div>
                <div class="mt-3 pt-2 border-t border-slate-100">
                    <span class="text-[10px] font-bold text-slate-500 uppercase block">Scan with Khalti App</span>
                    <span class="text-[11px] font-extrabold text-purple-900 block">Instant Voluntary Aid</span>
                </div>
            </div>

            <!-- 3. BANK QR FRAME -->
            <div class="qr-frame rounded-2xl p-4 text-center border-2 border-blue-500/30 flex flex-col justify-between shadow-xl">
                <div>
                    <div class="bg-bank text-white font-heading font-extrabold text-xs py-1.5 px-3 rounded-xl mb-3 flex items-center justify-center gap-1.5 shadow-sm">
                        <span class="w-2 h-2 rounded-full bg-sky-300"></span>
                        Bank QR (cIPS / Direct)
                    </div>
                    <div id="qr-bank-container" class="w-[150px] h-[150px] mx-auto bg-white p-1 rounded-xl flex items-center justify-center border border-slate-100">
                        <!-- Rendered by QRCode.js -->
                    </div>
                </div>
                <div class="mt-3 pt-2 border-t border-slate-100">
                    <span class="text-[10px] font-bold text-slate-500 uppercase block">Scan with Mobile Banking</span>
                    <span class="text-[11px] font-extrabold text-blue-900 block">connectIPS / Any Bank App</span>
                </div>
            </div>

        </div>

        <!-- TRUSTWORTHY MOTIVATIONAL FOOTER BANNER -->
        <div class="mt-4 bg-emerald-950/90 border border-amber-400/30 rounded-2xl p-4 text-center space-y-1.5 relative z-10">
            <p class="text-xs sm:text-sm font-bold text-amber-300 leading-relaxed">
                “आज तपाईंले दान गर्नुहोस्—कसैको आवश्यकता पूरा हुन्छ, कसैको दुःख कम हुन्छ, र तपाईंको यो राम्रो कर्म ईश्वरको कृपा, बरकत र समृद्धिको माध्यम बन्छ।” 🤲❤️💰
            </p>
            <p class="text-[11px] text-emerald-200/90 italic font-medium">
                “Donate today—someone’s need will be fulfilled, someone’s hardship will be eased, and your good deed can become a means of God’s grace, blessings and prosperity.”
            </p>
        </div>

        <!-- FOOTER BRAND MARK -->
        <div class="mt-6 pt-4 border-t border-emerald-800/60 flex flex-col sm:flex-row items-center justify-between text-[11px] text-emerald-300/80 font-medium relative z-10">
            <span>MSR — Make Someone Rise (Hope & Help)</span>
            <span>Official Portal: msr.com.np</span>
        </div>

    </div>

    <!-- JAVASCRIPT & HIGH-RES CANVAS EXPORTER -->
    <script>
        const QR_DATA = {
            esewa: '{"eSewa_id":"9807648317","name":"Isul Kawari"}',
            khalti: '{"Khalti_ID": "9807648317", "name": "Ishul Kawari"}',
            bank: '{"accountNumber":"0315759479191001","accountName":"ISHUL KAWARI","bankCode":"BOALNPKA","accountType":"Sarbashrestha Sahaj Bachat Khata Online","bankCodeCIPS":"2301"}'
        };

        function renderAllQRCodes() {
            const size = 150;
            
            // eSewa
            new QRCode(document.getElementById("qr-esewa-container"), {
                text: QR_DATA.esewa,
                width: size,
                height: size,
                colorDark: "#000000",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.H
            });

            // Khalti
            new QRCode(document.getElementById("qr-khalti-container"), {
                text: QR_DATA.khalti,
                width: size,
                height: size,
                colorDark: "#000000",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.H
            });

            // Bank QR
            new QRCode(document.getElementById("qr-bank-container"), {
                text: QR_DATA.bank,
                width: size,
                height: size,
                colorDark: "#000000",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.H
            });
        }

        function downloadPosterImage() {
            // Render onto an HTML5 Canvas to produce crisp high-res 1200x1600 image
            const width = 1200;
            const height = 1500;

            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');

            // 1. Dark Emerald Gradient Background
            const bgGradient = ctx.createLinearGradient(0, 0, 0, height);
            bgGradient.addColorStop(0, '#052e16');
            bgGradient.addColorStop(0.5, '#14532d');
            bgGradient.addColorStop(1, '#0a3a1f');
            ctx.fillStyle = bgGradient;
            ctx.fillRect(0, 0, width, height);

            // Outer Gold Border
            ctx.strokeStyle = '#f4b942';
            ctx.lineWidth = 8;
            ctx.strokeRect(30, 30, width - 60, height - 60);

            // 2. Header Badge
            ctx.fillStyle = '#052e16';
            ctx.beginPath();
            ctx.roundRect(width/2 - 250, 70, 500, 45, 22);
            ctx.fill();
            ctx.strokeStyle = '#f4b942';
            ctx.lineWidth = 2;
            ctx.stroke();

            ctx.fillStyle = '#f4b942';
            ctx.font = 'bold 18px Poppins, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('100% TRANSPARENT & VERIFIED INITIATIVE', width/2, 98);

            // 3. Title MSR
            ctx.fillStyle = '#ffffff';
            ctx.font = 'black 64px Poppins, sans-serif';
            ctx.fillText('MSR — MAKE SOMEONE RISE', width/2, 200);

            ctx.fillStyle = '#f4b942';
            ctx.font = 'bold 24px Inter, sans-serif';
            ctx.fillText('“तपाईंको सानो सहयोग, कसैको जीवन उठाउने ठूलो शक्ति बन्न सक्छ।”', width/2, 245);

            // Trust Subtitle
            ctx.fillStyle = '#dcfce7';
            ctx.font = 'italic 20px Inter, sans-serif';
            ctx.fillText('“Your small contribution can become a powerful force that helps someone rise again.”', width/2, 280);

            // 4. Draw 3 QR Boxes Side-by-Side
            const qrBoxes = [
                { title: 'eSewa QR', color: '#60bb46', containerId: 'qr-esewa-container', label: 'Scan with eSewa App' },
                { title: 'Khalti QR', color: '#5c2d91', containerId: 'qr-khalti-container', label: 'Scan with Khalti App' },
                { title: 'Bank QR (cIPS)', color: '#00529b', containerId: 'qr-bank-container', label: 'Scan with Any Bank App' }
            ];

            const boxWidth = 320;
            const boxHeight = 440;
            const startX = 80;
            const gap = 60;
            const startY = 340;

            qrBoxes.forEach((box, idx) => {
                const x = startX + idx * (boxWidth + gap);

                // White Box Background
                ctx.fillStyle = '#ffffff';
                ctx.beginPath();
                ctx.roundRect(x, startY, boxWidth, boxHeight, 24);
                ctx.fill();

                // Header Pill inside box
                ctx.fillStyle = box.color;
                ctx.beginPath();
                ctx.roundRect(x + 20, startY + 20, boxWidth - 40, 50, 16);
                ctx.fill();

                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 22px Poppins, sans-serif';
                ctx.fillText(box.title, x + boxWidth/2, startY + 52);

                // Get QR Canvas/Img from DOM
                const container = document.getElementById(box.containerId);
                const qrCanvas = container.querySelector('canvas');
                const qrImg = container.querySelector('img');

                let source = qrCanvas;
                if (!source && qrImg) {
                    source = qrImg;
                }

                if (source) {
                    ctx.drawImage(source, x + (boxWidth - 240)/2, startY + 90, 240, 240);
                }

                // Sub-label below QR
                ctx.fillStyle = '#64748b';
                ctx.font = 'bold 16px Inter, sans-serif';
                ctx.fillText(box.label, x + boxWidth/2, startY + 370);

                ctx.fillStyle = '#166534';
                ctx.font = 'bold 16px Inter, sans-serif';
                ctx.fillText('Instant Voluntary Aid', x + boxWidth/2, startY + 400);
            });

            // 5. Trust Quote Box at Bottom
            const quoteY = 820;
            ctx.fillStyle = '#052e16';
            ctx.beginPath();
            ctx.roundRect(80, quoteY, width - 160, 480, 24);
            ctx.fill();
            ctx.strokeStyle = '#f4b942';
            ctx.lineWidth = 3;
            ctx.stroke();

            // Inspiring lines in Canvas
            ctx.fillStyle = '#f4b942';
            ctx.font = 'bold 24px Noto Sans Devanagari, sans-serif';
            ctx.fillText('“तपाईंले आज गर्ने सानो दानले कसैको ठूलो आवश्यकता पूरा हुन्छ;”', width/2, quoteY + 60);

            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 22px Noto Sans Devanagari, sans-serif';
            ctx.fillText('“तपाईंले बाँडेको सहयोगको माध्यमबाट ईश्वरले तपाईंको जीवनमा अझ धेरै बरकत र समृद्धि ल्याउनुहुन्छ।” 🤲❤️', width/2, quoteY + 110);

            ctx.fillStyle = '#dcfce7';
            ctx.font = '20px Noto Sans Devanagari, sans-serif';
            ctx.fillText('“आज तपाईंले दान गर्नुहोस्—कसैको आवश्यकता पूरा हुन्छ, कसैको दुःख कम हुन्छ,”', width/2, quoteY + 180);

            ctx.fillStyle = '#f4b942';
            ctx.font = 'bold 21px Noto Sans Devanagari, sans-serif';
            ctx.fillText('“र तपाईंको यो राम्रो कर्म ईश्वरको कृपा, बरकत र समृद्धिको माध्यम बन्छ।” 🤲❤️💰', width/2, quoteY + 230);

            // English Translation Line in Poster
            ctx.fillStyle = '#e2e8f0';
            ctx.font = 'italic 18px Inter, sans-serif';
            ctx.fillText('“Donate today—someone’s need will be fulfilled, someone’s hardship will be eased,', width/2, quoteY + 310);
            ctx.fillText('and your good deed can become a means of God’s grace, blessings and prosperity.”', width/2, quoteY + 345);

            // 6. Footer Line
            ctx.fillStyle = '#f4b942';
            ctx.font = 'bold 22px Poppins, sans-serif';
            ctx.fillText('MSR — Make Someone Rise (Hope & Help Initiative) | msr.com.np', width/2, height - 70);

            // Download Trigger
            const link = document.createElement('a');
            link.download = 'MSR-Official-3in1-Donation-QR-Poster.png';
            link.href = canvas.toDataURL('image/png');
            link.click();
        }

        document.addEventListener('DOMContentLoaded', () => {
            renderAllQRCodes();
        });
    </script>
</body>
</html>

